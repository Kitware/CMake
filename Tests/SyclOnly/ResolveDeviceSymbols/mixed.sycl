#include "../SeparateCompilation/device.h"

SYCL_EXTERNAL int mixed_device_value();

int launch_mixed_kernel()
{
  sycl::queue queue;
  int* value = sycl::malloc_shared<int>(1, queue);
  if (!value) {
    return -1;
  }
  *value = 0;
  queue.single_task<class MixedResolvedKernel>(
    [=] { *value = mixed_device_value(); });
  queue.wait_and_throw();
  int result = *value;
  sycl::free(value, queue);
  return result;
}
