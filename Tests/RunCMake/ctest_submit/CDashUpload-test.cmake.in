cmake_minimum_required(VERSION 3.10)

set(CTEST_SITE "test-site")
set(CTEST_BUILD_NAME "test-build-name")
set(CTEST_SOURCE_DIRECTORY "@RunCMake_SOURCE_DIR@")
set(CTEST_BINARY_DIRECTORY "@RunCMake_TEST_BINARY_DIR@")
set(CTEST_SUBMIT_URL "$ENV{CTEST_SUBMIT_URL}")
ctest_start(Experimental)
ctest_submit(CDASH_UPLOAD "${CMAKE_CURRENT_LIST_FILE}"
  CDASH_UPLOAD_TYPE foo RETURN_VALUE result CAPTURE_CMAKE_ERROR error)
message(STATUS "submit result: ${result}")
