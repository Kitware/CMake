check_installed([[^lib;lib/libnamelink\.(so|dylib)$]])

if(APPLE)
  set(namelink "${CMAKE_INSTALL_PREFIX}/lib/libnamelink.dylib")
  set(expected libnamelink.1.dylib)
else()
  set(namelink "${CMAKE_INSTALL_PREFIX}/lib/libnamelink.so")
  set(expected libnamelink.so.1)
endif()
if(NOT IS_SYMLINK "${namelink}")
  set(RunCMake_TEST_FAILED "The installed namelink is not a symlink.")
  return()
endif()
file(READ_SYMLINK "${namelink}" actual)
if(NOT actual STREQUAL expected)
  set(RunCMake_TEST_FAILED "Namelink points to ${actual}, expected ${expected}.")
endif()
