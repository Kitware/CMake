include(${CMAKE_CURRENT_LIST_DIR}/check-data-dir.cmake)

file(GLOB test_snippets "${v1}/data/test-*.json")
list(LENGTH test_snippets snippet_count)
if(NOT snippet_count EQUAL 2)
  add_error("Expected two test snippets, got ${snippet_count}")
  return()
endif()

set(hashes)
foreach(snippet IN LISTS test_snippets)
  get_filename_component(filename "${snippet}" NAME)
  string(REGEX MATCH "^test-([0-9a-f]+)-" match "${filename}")
  list(APPEND hashes "${CMAKE_MATCH_1}")
endforeach()
list(GET hashes 0 first_hash)
list(GET hashes 1 second_hash)
if(first_hash STREQUAL second_hash)
  add_error("Test snippets have identical filename hashes")
endif()
