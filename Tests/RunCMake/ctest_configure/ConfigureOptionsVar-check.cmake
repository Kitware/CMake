set(cmakecache_file "${RunCMake_TEST_BINARY_DIR}/CMakeCache.txt")
if(EXISTS "${cmakecache_file}")
  file(READ "${cmakecache_file}" cmakecache_txt)
  if(NOT cmakecache_txt MATCHES "MY_VAR_A:STRING=from-var")
     set(RunCMake_TEST_FAILED "CMakeCache.txt does not contain MY_VAR_A")
  endif()
  if(NOT cmakecache_txt MATCHES "MY_VAR_B:STRING=from-var")
     string(APPEND RunCMake_TEST_FAILED
       "\nCMakeCache.txt does not contain MY_VAR_B")
  endif()
else()
  set(RunCMake_TEST_FAILED "CMakeCache.txt not found")
endif()
