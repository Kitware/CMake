include(RunCMake)

function(run_offload_build case)
  run_cmake(${case})
  set(RunCMake_TEST_BINARY_DIR ${RunCMake_BINARY_DIR}/${case}-build)
  set(RunCMake_TEST_NO_CLEAN 1)
  run_cmake_command(${case}-build ${CMAKE_COMMAND} --build . --verbose)
endfunction()

run_offload_build(FlagsImplyOn)
if(CMAKE_C_COMPILER_ID STREQUAL "GNU")
  run_offload_build(SwitchOn)
else()
  run_cmake(NoDefault)
endif()
run_offload_build(Off)
run_offload_build(OffEmpty)
run_offload_build(Unset)
run_offload_build(WhitespaceFlags)
run_offload_build(RefindFlags)
run_offload_build(RefindOff)
