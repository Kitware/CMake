# Emulate pkg-config for the static requery and modversion/variable tests.
# CMAKE_ARGV0..3 are: cmake -P <this file> --

macro(print_stdout value)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E echo "${value}")
endmacro()

set(static FALSE)
set(mode "")
set(pkg "")
set(variable "")
set(call "")

math(EXPR last_arg "${CMAKE_ARGC} - 1")
foreach(i RANGE 4 ${last_arg})
  set(arg "${CMAKE_ARGV${i}}")
  string(APPEND call " ${arg}")

  if(arg STREQUAL "--version")
    set(mode version)
  elseif(arg STREQUAL "--static")
    set(static TRUE)
  elseif(arg STREQUAL "--modversion")
    set(mode modversion)
  elseif(arg MATCHES "^--variable=(.*)$")
    if(NOT mode STREQUAL "modversion")
      set(mode variable)
    endif()
    set(variable "${CMAKE_MATCH_1}")
  elseif(arg STREQUAL "--cflags")
    set(mode cflags)
  elseif(arg STREQUAL "--libs")
    set(mode libs)
  elseif(NOT arg MATCHES "^--(print-errors|short-errors)$")
    string(REGEX REPLACE " .*" "" pkg "${arg}")
  endif()
endforeach()

if(NOT "$ENV{FAKE_PKG_CONFIG_LOG}" STREQUAL "")
  file(APPEND "$ENV{FAKE_PKG_CONFIG_LOG}" "${call}\n")
endif()

if(mode STREQUAL "version")
  if("$ENV{FAKE_PKG_CONFIG_FLAVOR}" STREQUAL "pkg-config")
    print_stdout("0.29.2")
  elseif("$ENV{FAKE_PKG_CONFIG_FLAVOR}" STREQUAL "pkgconf")
    print_stdout("2.1.0")
  else()
    print_stdout("1.0")
  endif()
  return()
endif()

if(pkg STREQUAL "good" OR pkg STREQUAL "bad")
  set(version "1.0")
  set(prefix "/fake;prefix")
elseif(pkg STREQUAL "normal")
  set(version "1.2.3")
  set(prefix "/fake/normal")
elseif(pkg STREQUAL "emptyversion")
  set(version "")
  set(prefix "/fake/emptyversion")
else()
  cmake_language(EXIT 1)
endif()

if(mode STREQUAL "modversion")
  print_stdout("${version}")
  if(NOT variable STREQUAL "")
    if("$ENV{FAKE_PKG_CONFIG_FLAVOR}" STREQUAL "pkg-config")
      message("Ignoring incompatible output option \"--variable\"")
    else()
      print_stdout("${prefix}")
    endif()
  endif()
  return()
elseif(mode STREQUAL "variable")
  if(variable STREQUAL "prefix")
    print_stdout("${prefix}")
  elseif(pkg STREQUAL "good" OR pkg STREQUAL "bad")
    print_stdout("/fake-${variable}")
  elseif(variable STREQUAL "includedir")
    print_stdout("/fake/${pkg}/include")
  elseif(variable STREQUAL "libdir")
    print_stdout("/fake/${pkg}/lib")
  endif()
  return()
elseif(mode STREQUAL "cflags")
  if(pkg STREQUAL "good" OR pkg STREQUAL "bad")
    print_stdout("-I/fake-include")
  else()
    print_stdout("-I/fake/${pkg}/include")
  endif()
  return()
elseif(mode STREQUAL "libs")
  if(pkg STREQUAL "good")
    if(static)
      print_stdout("-lgood -ldep")
    else()
      print_stdout("-lgood")
    endif()
  elseif(pkg STREQUAL "bad")
    if(static)
      cmake_language(EXIT 1)
    endif()
    print_stdout("-lbad")
  else()
    print_stdout("-L/fake/${pkg}/lib -l${pkg}")
  endif()
  return()
else()
  cmake_language(EXIT 1)
endif()
