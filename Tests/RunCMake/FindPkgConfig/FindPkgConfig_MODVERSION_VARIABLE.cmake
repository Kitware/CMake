set(PKG_CONFIG_EXECUTABLE "${CMAKE_COMMAND}")
set(PKG_CONFIG_ARGN "-P;${CMAKE_CURRENT_SOURCE_DIR}/pkg-config-static-requery.cmake;--")
set(ENV{FAKE_PKG_CONFIG_FLAVOR} "${flavor}")
find_package(PkgConfig REQUIRED)

set(log "${CMAKE_CURRENT_BINARY_DIR}/pkg-config.log")
set(ENV{FAKE_PKG_CONFIG_LOG} "${log}")

function(check var expect)
  if(NOT "${${var}}" STREQUAL "${expect}")
    message(SEND_ERROR "Expected ${var} to be \"${expect}\", got \"${${var}}\"")
  endif()
endfunction()

# Check whether the prefix was queried separately from --modversion
function(check_prefix_query expect)
  file(STRINGS "${log}" calls REGEX " --variable=prefix")
  list(FILTER calls EXCLUDE REGEX " --modversion")
  list(LENGTH calls count)
  if(NOT count EQUAL expect)
    message(SEND_ERROR "Expected ${expect} separate prefix queries, got ${count}")
  endif()
  file(REMOVE "${log}")
endfunction()

if(flavor STREQUAL "pkgconf")
  set(separate 0)
else()
  set(separate 1)
endif()

pkg_check_modules(NORMAL REQUIRED normal)
check(NORMAL_FOUND 1)
check(NORMAL_VERSION "1.2.3")
check(NORMAL_PREFIX "/fake/normal")
check(NORMAL_INCLUDEDIR "/fake/normal/include")
check(NORMAL_LIBDIR "/fake/normal/lib")
check(NORMAL_LIBRARIES "normal")
check_prefix_query(${separate})

pkg_check_modules(CONSTRAINT REQUIRED "normal>=1.0")
check(CONSTRAINT_VERSION "1.2.3")
check(CONSTRAINT_PREFIX "/fake/normal")
check_prefix_query(${separate})

pkg_check_modules(EMPTY REQUIRED emptyversion)
check(EMPTY_FOUND 1)
check(EMPTY_VERSION "")
check(EMPTY_PREFIX "/fake/emptyversion")
check(EMPTY_LIBRARIES "emptyversion")
check_prefix_query(${separate})

pkg_check_modules(BOTH REQUIRED normal emptyversion)
check(BOTH_normal_VERSION "1.2.3")
check(BOTH_normal_PREFIX "/fake/normal")
check(BOTH_emptyversion_VERSION "")
check(BOTH_emptyversion_PREFIX "/fake/emptyversion")
math(EXPR separate_both "${separate} * 2")
check_prefix_query(${separate_both})
