cmake_minimum_required(VERSION 3.10)
@CASE_CMAKELISTS_PREFIX_CODE@
project(CTestInstrumentation@CASE_NAME@)
include(CTest)
add_executable(main main.c)
add_test(NAME main COMMAND main)

if($ENV{USE_INSTRUMENTATION_CMD})
  cmake_instrumentation(
    API_VERSION 1
    DATA_VERSION 1
    OPTIONS cdashVerbose
    CUSTOM_CONTENT exampleContent STRING exampleData
  )
endif()
if($ENV{USE_PROCESS_METRICS})
  cmake_instrumentation(
    API_VERSION 1
    DATA_VERSION 1.2
    OPTIONS processMetrics cdashSubmit
    CALLBACK "${CMAKE_COMMAND}" -P "@RunCMake_SOURCE_DIR@/save-process-metrics.cmake"
  )
endif()
@CASE_CMAKELISTS_SUFFIX_CODE@
