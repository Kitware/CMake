if(directory_kind STREQUAL "config")
  set(suffix "-debug")
else()
  set(suffix "")
endif()

set(kinds link)
if(check_compile_pdb)
  list(APPEND kinds compile)
endif()

foreach(kind IN LISTS kinds)
  if(kind STREQUAL "link")
    set(dir pdb)
  else()
    set(dir cpdb)
  endif()
  set(expected "${artifact_path}/${dir}${suffix}/${target_name}/${target_name}-${kind}.pdb")
  if(NOT EXISTS "${expected}")
    message(SEND_ERROR "${kind} PDB not created in the expected path:\n  ${expected}")
  endif()
endforeach()
