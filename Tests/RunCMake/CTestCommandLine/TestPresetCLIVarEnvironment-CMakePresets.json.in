{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "my-configure-preset",
      "generator": "@RunCMake_GENERATOR@",
      "binaryDir": "${sourceDir}/build"
    }
  ],
  "testPresets": [
    {
      "name": "my-test-preset",
      "configurePreset": "my-configure-preset",
      "environment": {
        "DASHBOARD_PRESET_ENV": "from-preset"
      }
    }
  ]
}
