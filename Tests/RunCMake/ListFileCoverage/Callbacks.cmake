function(keep value out)
  set(${out} TRUE PARENT_SCOPE)
endfunction()
function(cmp a b out)
  if(a STRLESS b)
    set(${out} TRUE PARENT_SCOPE)
  else()
    set(${out} FALSE PARENT_SCOPE)
  endif()
endfunction()
function(twice value out)
  set(${out} "${value}${value}" PARENT_SCOPE)
endfunction()
set(l c a b)
list(FILTER l INCLUDE PREDICATE keep)
list(SORT l COMPARATOR cmp)
list(TRANSFORM l APPLY twice)
