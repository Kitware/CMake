if(actual_stdout MATCHES "has no symbols|table of contents is empty")
  string(APPEND RunCMake_TEST_FAILED
    "Archiver warned about missing symbols:\n${actual_stdout}\n")
endif()

file(GLOB_RECURSE generated "${RunCMake_TEST_BINARY_DIR}/lib_autogen/include*/*")
set(found_placeholder 0)
foreach(file IN LISTS generated)
  file(READ "${file}" content)
  if(content MATCHES "^enum some_compilers")
    set(found_placeholder 1)
    if(NOT content MATCHES "cmake_automoc_silence_linker_warning")
      string(APPEND RunCMake_TEST_FAILED "Placeholder symbol missing in:\n  ${file}\n")
    endif()
  endif()
endforeach()
if(NOT found_placeholder)
  string(APPEND RunCMake_TEST_FAILED "No module unit placeholder found.\n")
endif()
